{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "__GADAK_HOOK__" }] }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "__GADAK_HOOK__" }]
      }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "__GADAK_HOOK__", "timeout": 60 }] }
    ],
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "__GADAK_HOOK__", "timeout": 10 }] }
    ]
  }
}
