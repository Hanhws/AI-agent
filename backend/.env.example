# 이 파일을 backend/.env 로 복사해서 써요. .env는 커밋하지 않아요.

# 가닥이 판단에 쓰는 LLM(엔진). docs/usage-guide.md 참고
#   auto           Claude Code가 있으면 claude_cli, 없고 API 키가 있으면 anthropic_api, 둘 다 없으면 none
#   claude_cli     Claude 구독(Pro · Max)으로. API 키가 필요 없어요
#   anthropic_api  Anthropic API 키로. 쓴 만큼 그 키로 돈이 나가요
#   none           LLM 없이 기록만
GADAK_ENGINE=auto

# 엔진이 쓸 모델 (haiku · sonnet · opus, 또는 claude-로 시작하는 모델 이름)
GADAK_ENGINE_MODEL=haiku

# API 키는 여기에 적지 않아요. 가닥이 받아서 macOS 키체인에 넣어요 (docs/usage-guide.md 3-2).
# 키체인이 없는 운영체제에서만 환경 변수 ANTHROPIC_API_KEY를 봐요.

# 백엔드 주소와 데이터 위치 (기본값 그대로 써도 돼요)
# GADAK_PORT=7311
# GADAK_HOME=~/.gadak

# 한 번 켠 동안 정리(1단 분류 + 2단 확인)에 쓰는 LLM 호출 수의 한도 (기본 150). 넘으면 멈추고, 화면의 ‘정리 다시’로 이어 가요
# GADAK_MAX_CALLS=150

# 2단(놓친 일 찾기)이 한 턴에서 엔진에 묻는 걸음 수의 한도 (기본 5)
# GADAK_MAX_STEPS=5

# 2단에 쓸 모델. 비우면 GADAK_ENGINE_MODEL과 같아요
# GADAK_CHECK_MODEL=sonnet

# 앞길 살피기: ‘앞길 보기’를 눌렀을 때 하려는 일을 읽고, 갈 수 있는 길을 미리 찾아봐요 (누를 때만 돌아요 · docs/usage-guide.md 3-4)
# GADAK_AHEAD=0             # 앞길 살피기의 버튼 둘(저절로 살피기 켬 · 끔 · 앞길 보기)을 감춰요
# GADAK_AHEAD_AUTO=1        # ‘저절로 살피기’의 처음 값을 켬으로 (화면에서 켜고 끈 것이 먼저예요 · 한 곳에 Claude Pro 5시간 한도의 0.7%쯤을 써요)
# GADAK_AHEAD_WEB=1          # 웹에서도 찾아봐요. 대화에서 뽑은 검색어가 밖으로 나가요
# GADAK_AHEAD_FILES=0        # 작업 폴더의 파일을 읽지 않게
# GADAK_AHEAD_MODEL=sonnet   # 길을 찾는 모델 (기본 sonnet. 비우면 2단과 같은 모델)

# 사용 기록을 받는 가닥 팀 서버 주소 (server/). 비워 두면 묻지도 보내지도 않아요. docs/usage-guide.md 6-1
# GADAK_COLLECT_URL=http://127.0.0.1:7321
